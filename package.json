{
  "name": "raw-swap",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo run build",
    "build:libs": "pnpm --filter @rawswap/shared build && pnpm --filter @rawswap/lp-sdk build && pnpm --filter @rawswap/tx-composer build && pnpm --filter @rawswap/tx-verifier build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "seed:liquidity-pools": "tsx scripts/seed-dev-liquidity-pools.ts",
    "typecheck": "turbo typecheck",
    "test:smoke": "bash scripts/smoke-test.sh"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/spl-token-metadata": "^0.1.6",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
