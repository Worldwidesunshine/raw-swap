NODE_ENV=production
PORT=3001
DATABASE_URL=
REDIS_URL=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Optional: regional endpoint; when set, overrides JITO_BLOCK_ENGINE_URL in the API
JITO_REGION=
CORS_ORIGIN=https://your-frontend-host,https://your-admin-host
EXECUTION_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
INTERNAL_API_ACCESS_TOKEN=replace-with-a-long-random-internal-secret
WORKER_METRICS_PORT=3002
GRAFANA_ADMIN_PASSWORD=change-me
ENABLE_API_DOCS=0
TRUST_PROXY=1
DEBRIDGE_PROXY_TIMEOUT_MS=10000
# Web (build-time / client)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_API_URL=https://your-api-host
