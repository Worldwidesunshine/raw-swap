# API
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://rawswap:rawswap@localhost:5432/rawswap
REDIS_URL=redis://localhost:6379
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_REGION=
CORS_ORIGIN=http://localhost:3000
EXECUTION_ACCESS_TOKEN_SECRET=rawswap-dev-execution-access-token-secret-change-me
INTERNAL_API_ACCESS_TOKEN=rawswap-dev-internal-api-access-token-change-me
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_API_URL=http://localhost:3001
WORKER_METRICS_PORT=3002
ENABLE_API_DOCS=1
TRUST_PROXY=0
DEBRIDGE_PROXY_TIMEOUT_MS=10000

# Protocol Fee Wallets (required for swap fees to flow)
# Generate with: solana-keygen new --outfile ~/rawswap-keys/<name>.json
# PROTOCOL_FEE_VAULT=<pubkey of fee vault — receives 12bps buyback portion>
# TREASURY_WALLET=<pubkey of treasury — receives 4bps team portion>

# RAWSWAP Token Mint (set after running scripts/create-rawswap-token.ts)
# RAWSWAP_MINT=<pubkey of deployed Token-2022 mint>

# Liquidity Pool Addresses (set after running scripts/create-rawswap-pools.ts)
# ORCA_RAWSWAP_SOL_POOL=<orca whirlpool splash pool address>
# RAYDIUM_RAWSWAP_SOL_POOL=<raydium cpmm pool address>

# deBridge Affiliate (optional — earn from cross-chain bridge volume)
# DEBRIDGE_AFFILIATE_RECIPIENT=<pubkey — can reuse TREASURY_WALLET>
# DEBRIDGE_AFFILIATE_FEE_PERCENT=1

# Optional: dev-only unsigned placeholder tx for POST /api/liquidity/deposit|withdraw (501 otherwise)
# LP_DEV_STUB_LIQUIDITY_TX=1

# Optional: OpenTelemetry export for apps/api (disable with OTEL_SDK_DISABLED=1)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_SDK_DISABLED=1

